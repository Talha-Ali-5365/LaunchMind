# OpenAI-compatible API (e.g. Metaminds)
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://t-api.metaminds.live/v1
OPENAI_MODEL=gpt-5.4-mini

# GitHub (classic PAT: repo, workflow)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=your-username/launchmind-your-group

# Slack bot (chat:write, channels:read, channels:join). Invite the bot to SLACK_CHANNEL.
# Set SLACK_DISABLED=true to skip all Slack posts (e.g. no token yet).
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CHANNEL=#launches
SLACK_DISABLED=false

# Resend (https://resend.com/docs/send-with-python)
# With FROM_EMAIL=onboarding@resend.dev, Resend only allows TO_EMAIL to be the exact
# address on your Resend account (testing). For other recipients, verify a domain and
# use from=you@yourdomain.com.
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=onboarding@resend.dev
TO_EMAIL=same-as-your-resend-account@gmail.com

# Optional
MAX_REVISION_ROUNDS=3
ENGINEER_BRANCH_PREFIX=agent-landing-page

# Per-run output folder: run_log.json, links.json/txt, index.html. Relative to repo root.
OUTPUT_DIR=output
SAVE_RUN_LOGS=true
